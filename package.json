{
  "name": "sft-dev",
  "version": "0.1.0",
  "private": true,
  "description": "SFT-Dev - Git-native build & repair intelligence platform (M1 foundation)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @sft/api db:generate",
    "db:migrate": "pnpm --filter @sft/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["linux", "win32"],
      "cpu": ["x64"]
    }
  }
}