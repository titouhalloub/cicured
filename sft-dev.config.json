{
  "tasks": [
    { "name": "Type Check", "command": "pnpm -r typecheck" },
    { "name": "Lint",       "command": "pnpm -r lint" },
    { "name": "Build",      "command": "pnpm -r build" },
    { "name": "Tests",      "command": "pnpm -r test" },
    { "name": "Security",   "command": "semgrep --config=/opt/sft/semgrep-rules.yaml --json --no-git-ignore --quiet --metrics=off" },
    { "name": "Python Tests", "command": "python3 -m pytest packages/parser/test/fixtures/pytest-fixture -v", "parser": "pytest" },
    { "name": "Go Tests", "command": "sh -c 'cd packages/parser/test/fixtures/graph-fixture-go && go test -json ./...'", "parser": "go-test" },
    { "name": "Rust Tests", "command": "sh -c 'cd packages/parser/test/fixtures/graph-fixture-rust && cargo test --no-fail-fast'", "parser": "cargo-test" }
  ],
  "llm": {
    "provider": "openai-compatible",
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "google/gemini-2.5-flash",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "pricing": {
      "inputPerM": 0.30,
      "outputPerM": 2.50
    }
  }
}