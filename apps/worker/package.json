    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
