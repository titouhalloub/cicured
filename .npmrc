# Workspace packages are consumed as TypeScript source (see README "Internal packages").
strict-peer-dependencies=false
auto-install-peers=true

# Repo-local registry override (Step 2 of the M1 verification run): the default
# registry.npmjs.org is extremely slow from this network (tarballs at 5-40 KiB/s).
# https://registry.npmmirror.com is a public read-through mirror of the npm
# registry. Repo-local only - do NOT set this globally.
registry=https://registry.npmmirror.com
