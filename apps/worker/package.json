{
  "name": "@sft/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SFT-Dev worker - BullMQ consumer that runs one hardened Docker sandbox per run (M2a)",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
