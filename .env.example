# ─── LLM (suggestion engine, M4a) ──────────────────────────────────────────
# Supported providers: anthropic, openrouter.
# Set the key for the selected provider; the other key may remain blank.
LLM_PROVIDER=openrouter
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter model IDs use provider/model notation, e.g. anthropic/claude-sonnet-4.5.
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_CACHE_TTL_SECONDS=2592000
LLM_FINDINGS_PER_RUN_CAP=50
