# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Postgres 16 (docker-compose.yml) ──────────────────────────────────────
POSTGRES_USER=sft
POSTGRES_PASSWORD=sft
POSTGRES_DB=sft_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://sft:sft@localhost:5432/sft_dev

# ─── Redis 7 / BullMQ (docker-compose.yml) ─────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
SFT_QUEUE_NAME=sft-runs
# Redis pub/sub channel prefix for live log streaming (M2b-1).
# The API and the worker MUST agree on this value.
SFT_LOG_CHANNEL_PREFIX=sft:logs:

# ─── API (apps/api) ────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
# HMAC key for session cookies (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-chars-of-randomness
SESSION_TTL_HOURS=168
# AES-256-GCM key for projects.installation_id_enc and project_env_vars.value_enc.
# Accepts base64 (32 bytes) or 64-char hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SFT_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# ─── GitHub (apps/api) ─────────────────────────────────────────────────────
# OAuth app - user login: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App - installation tokens for repo listing / clone
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64-encoded PEM on a single line:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('app.pem','utf8')).toString('base64'))"
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_BASE=https://github.com

# ─── Worker (apps/worker) ──────────────────────────────────────────────────
# The worker consumes the same queue (SFT_QUEUE_NAME) and runs one hardened
# Docker sandbox per run. It needs access to the Docker socket.
# Sandbox image built from the repo root:
#   docker build -f docker/sandbox/Dockerfile -t cicured/sandbox:node20 .
SANDBOX_IMAGE=cicured/sandbox:node20
# Where validated sft-report.json files are written (S3 archival is M2b).
REPORTS_DIR=./tmp/reports
# Per-task cap handed to the runner (its own default is also 10 min).
SFT_TASK_TIMEOUT_MS=600000
# Wall-clock budget per run: the container is killed after this (15 min).
SFT_DEADLINE_BUDGET_MS=900000
# Host path of the pinned runner, bind-mounted read-only into each sandbox.
# Defaults to <repo>/packages/runner/sft-dev.mjs when unset.
# SFT_RUNNER_HOST_PATH=/abs/path/to/packages/runner/sft-dev.mjs

# ─── Object storage (MinIO local / AWS S3 prod) ────────────────────────────
# Same config must be used by the API and worker so presigned URLs verify.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=cicured-logs
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Webhooks (M2b-2c) ────────────────────────────────────────────────────
# Leave blank in dev. When set, HMAC-SHA256 of the raw body is verified.
GITHUB_WEBHOOK_SECRET=

# ─── LLM (suggestion engine, M4a) ──────────────────────────────────────────
# Leave ANTHROPIC_API_KEY blank to disable the suggestion stage entirely.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_CACHE_TTL_SECONDS=2592000
LLM_FINDINGS_PER_RUN_CAP=50


# ─── Web (apps/web) ────────────────────────────────────────────────────────
# Public URL of the API. The session cookie is sent automatically with
# credentials: "include".
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Production overrides ──────────────────────────────────────────
# In production:
#   - SESSION_SECRET, SFT_ENCRYPTION_KEY, GITHUB_WEBHOOK_SECRET,
#     S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY must be freshly generated
#     (never reuse dev values).
#   - API_PUBLIC_URL and WEB_APP_URL must be the real public URLs.
#   - S3_ENDPOINT should be unset for real AWS S3, or set to your
#     MinIO address. If unset, forcePathStyle is off.
#   - NODE_ENV=production (already set by docker-compose.prod.yml).
#   - LOG_FORMAT=json recommended for structured logging.
#   - The worker requires /var/run/docker.sock. In production use a
#     socket proxy (tecnativa/docker-socket-proxy) rather than mounting
#     the host socket directly.

LOG_FORMAT=json

